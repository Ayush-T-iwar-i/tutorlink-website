# ---------------------------------------------------------------------------
# Used by `docker compose` (it reads a file named .env in THIS folder).
# Copy to .env and fill in real values:   cp .env.example .env
# Never commit .env. For running WITHOUT Docker, use backend/.env.example instead.
# ---------------------------------------------------------------------------

# REQUIRED — compose refuses to start without these three.
DB_PASSWORD=choose_a_strong_database_password
MYSQL_ROOT_PASSWORD=choose_a_different_strong_root_password
# 32+ random characters:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Database user / name (defaults shown)
DB_USER=tutorlink_user
DB_NAME=tutorlink

# Your public site address (no trailing slash). ALLOWED_ORIGIN must be the real origin in production.
ALLOWED_ORIGIN=http://localhost:5000
FRONTEND_URL=http://localhost:5000

APP_TIMEZONE=Asia/Kolkata

# Optional integrations — leave empty to disable (see backend/.env.example for what each one does)
GOOGLE_CLIENT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
REFUND_WINDOW_HOURS=24