# Backend settings for running WITHOUT Docker:  cp backend/.env.example backend/.env
# (Docker Compose uses the separate .env.example in the repository root.)
# Never commit .env.

NODE_ENV=development
PORT=5000

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=tutorlink_user
DB_PASSWORD=
DB_NAME=tutorlink
DB_POOL_SIZE=10

# Auth - JWT_SECRET must be 32+ random characters:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
BCRYPT_ROUNDS=12
# Optional: lets `node create-admin.js` run without a password prompt
ADMIN_PASSWORD=

# Site / CORS
ALLOWED_ORIGIN=http://localhost:5000
FRONTEND_URL=http://localhost:5000
APP_TIMEZONE=Asia/Kolkata
TRUST_PROXY=1
CSP_MODE=report-only
LOG_LEVEL=info

# Teacher search: radius (km) used when the request does not send one
DEFAULT_RADIUS_KM=5

# Optional integrations - leave empty to disable
GOOGLE_CLIENT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
REFUND_WINDOW_HOURS=24
