# ============================================
# TutorLink Backend — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file to GitHub.
# ============================================

# Server
PORT=5000
NODE_ENV=production

# Frontend URL (used for password reset emails and CORS)
# e.g. https://tutorlink.com or http://localhost:5000
FRONTEND_URL=http://localhost:5000

# CORS — set this to your real deployed frontend domain in production
# e.g. https://tutorlink.com (use * only for local development)
ALLOWED_ORIGIN=*

# MySQL Database
# For local development (XAMPP/MySQL): host=localhost, user=root, password=(blank)
# For production: use your hosting provider's database credentials
# (Railway, Render, PlanetScale, AWS RDS, etc. all give you these values)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=tutorlink

# Auth
# Generate a long random string for production, e.g. run:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string

# Default search radius (in km)
DEFAULT_RADIUS_KM=5

# Google Sign-In (Optional)
# Get this from https://console.cloud.google.com/apis/credentials
# 1. Create a project -> Create Credentials -> OAuth client ID -> Web application
# 2. Add your site URL (e.g. http://localhost:5000) under "Authorized JavaScript origins"
# 3. Paste the Client ID below. Leave blank to hide the Google button.
GOOGLE_CLIENT_ID=

# Email / SMTP Configuration (Optional - logs to console if empty)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password
SMTP_FROM="TutorLink" <noreply@tutorlink.com>

# Twilio SMS Configuration (Optional - logs to console if empty)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Razorpay Online Payments (Optional - manual payment used if empty)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
