{
  "name": "tutorlink-backend",
  "version": "1.0.0",
  "description": "TutorLink website backend - Node.js + Express + MySQL",
  "main": "server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --runInBand --selectProjects unit",
    "test:coverage": "jest --coverage --runInBand --selectProjects unit",
    "db:init": "node database/init-db.js",
    "test:integration": "jest --runInBand --selectProjects integration",
    "test:all": "jest --runInBand",
    "db:migrate": "node database/migrate.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.2.0",
    "file-type": "^16.5.4",
    "google-auth-library": "^9.11.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "mysql2": "^3.10.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.14",
    "razorpay": "^2.9.4",
    "twilio": "^5.3.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "projects": [
      {
        "displayName": "unit",
        "testEnvironment": "node",
        "testPathIgnorePatterns": [
          "/node_modules/",
          "/tests/integration/"
        ],
        "setupFilesAfterEnv": [
          "<rootDir>/tests/setup-unit.js"
        ]
      },
      {
        "displayName": "integration",
        "testEnvironment": "node",
        "testMatch": [
          "<rootDir>/tests/integration/**/*.test.js"
        ],
        "globalSetup": "<rootDir>/tests/integration/global-setup.js",
        "setupFiles": [
          "<rootDir>/tests/integration/setup-env.js"
        ],
        "testTimeout": 30000
      }
    ]
  }
}